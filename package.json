{
  "name": "haiku-pwa",
  "version": "0.1.0",
  "private": true,
  "description": "Personal comic book collection PWA: check an issue number, add it with a photo, and look up metadata from comics.org and inducks.org.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "node server/index.js",
    "sync:inducks": "node server/scripts/sync-inducks.js",
    "test": "node --test tests/server/*.test.js",
    "test:e2e": "playwright test",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "express": "^5.3.0",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@preact/preset-vite": "^2.10.6",
    "concurrently": "^9.2.5",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0"
  }
}
