{
  "name": "haiku-pwa",
  "version": "0.1.0",
  "private": true,
  "description": "Personal comic book collection PWA: check an issue number, add it with a photo, and look up metadata from comics.org and inducks.org. Go API, Preact client.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"go run ./cmd/server\" \"vite\"",
    "build": "vite build",
    "start": "go run ./cmd/server",
    "sync:inducks": "go run ./cmd/sync-inducks",
    "test": "go test -race -count=1 ./...",
    "lint": "golangci-lint run ./...",
    "test:e2e": "playwright test",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@preact/preset-vite": "^2.10.6",
    "concurrently": "^9.2.5",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0"
  }
}
